# Copy this file to .env and fill in real values. Never commit .env.
# No real keys or addresses belong in this file — placeholders only.

# GEMINI_API_KEY: optional. Used for LLM market narratives and macro summaries.
# Without it, the app uses built-in fallback summaries. In AI Studio this is
# injected automatically from user secrets.
GEMINI_API_KEY=your-gemini-api-key

# APP_URL: The URL where this app is hosted. Used for self-referential links.
APP_URL=http://localhost:3000

# RESEND_API_KEY: REQUIRED for sending any email (daily, weekly, news, welcome).
# Get a free key from Resend (https://resend.com). Set it as an environment
# variable / secret on the host. Never commit it.
RESEND_API_KEY=your-resend-api-key

# EMAIL_FROM: REQUIRED for sending. The sender address shown on every email.
# It must be a sender verified in Resend (a verified domain, or a single
# verified sender address), e.g. "PSX AlphaBrief <updates@example.com>".
# Resend rejects sends from unverified senders.
EMAIL_FROM=PSX AlphaBrief <updates@example.com>

# RESEND_BASE_URL: optional, tests only. Overrides the Resend API base URL so
# tests can point at a local mock server. Leave unset in production.
# RESEND_BASE_URL=http://127.0.0.1:4100
